    "logicalPlaces": [
        {
            "id": "set1",
            "name": "Places with low danger",
            "expression": "danger == 'low' || danger == 'null'",
            "query": "MATCH (p:Place) WHERE NOT EXISTS {   MATCH (p)-[:AFFECTS]-(h:Hazard) WHERE NOT h.level IN ['low', 'none'] } RETURN DISTINCT p;"
        },
        {
            "id": "set2",
            "name": "Places with high danger",
            "query": "MATCH (p:Place) WHERE EXISTS { MATCH (p)-[:AFFECTS]-(h:Hazard) WHERE h.level IN ['medium', 'high']} RETURN DISTINCT p;"
        },
        {
            "id": "set3",
            "name": "Places inside university",
            "query": "MATCH (p:Place) WHERE p.amenity = 'university' RETURN p;"
        },
        {
            "id": "set4",
            "name": "Gathering points",
            "query": "MATCH (p:Place) WHERE p.amenity = 'gatheringPoint' RETURN p;"
        },
        {
            "id": "set5",
            "name": "Signalled areas",
            "query": "MATCH (p:Place) WHERE p.signalled = true RETURN p;"
        }
    ],

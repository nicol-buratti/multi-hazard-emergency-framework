# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env

# Ignore all contents of the Node-RED folder...
node-red/node_red_data/*

# ...except for the essential project files
!node-red/node_red_data/flows.json
!node-red/node_red_data/package.json
!node-red/node_red_data/settings.js

# (Optional) If you use custom nodes or libraries, keep the package-lock as well
!node-red/node_red_data/package-lock.json

# MAKE SURE TO IGNORE CREDENTIALS (for security)
node-red/node_red_data/flows_cred.json

.pytest_cache

worker-ai/tables/*
*.csv
*.tex
